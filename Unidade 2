class TestOperacoes(unittest.TestCase):
    """Testa as operações matemáticas."""

    def test_somar(self):
        casos = [
            (5, 3, 8),
            (-5, 3, -2),
        ]

        for a, b, esperado in casos:
            with self.subTest(a=a, b=b):
                self.assertEqual(somar(a, b), esperado)

    def test_subtrair(self):
        casos = [
            (5, 3, 2),
            (3, 5, -2),
        ]

        for a, b, esperado in casos:
            with self.subTest(a=a, b=b):
                self.assertEqual(subtrair(a, b), esperado)

    def test_multiplicar(self):
        casos = [
            (5, 3, 15),
            (-5, 3, -15),
        ]

        for a, b, esperado in casos:
            with self.subTest(a=a, b=b):
                self.assertEqual(multiplicar(a, b), esperado)

    def test_dividir(self):
        self.assertEqual(dividir(10, 2), 5)
        self.assertAlmostEqual(dividir(10, 3), 3.333, places=2)

        with self.assertRaisesRegex(ValueError, "Divisão por zero"):
            dividir(10, 0)

    def test_potencia(self):
        self.assertEqual(potencia(2, 3), 8)
        self.assertEqual(potencia(5, 0), 1)

    def test_raiz_quadrada(self):
        self.assertEqual(raiz_quadrada(16), 4)
        self.assertEqual(raiz_quadrada(0), 0)

        with self.assertRaisesRegex(ValueError, "número negativo"):
            raiz_quadrada(-1)


