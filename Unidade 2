        "# Projeto de Calculadora Simples\n",
        "# Desenvolvido por um estudante de Sistemas de Informação\n",
        "#Prompt: Crie um projeto simples em português de calculadora como se fosse um estudante de sistemas de informação, diminua o uso de if/elif e siga as boas práticas\n",
        "\n",
        "# 1. Funções para as operações básicas\n",
        "def somar(a, b):\n",
        "    \"\"\"Retorna a soma de dois números.\"\"\"\n",
        "    return a + b\n",
        "\n",
        "def subtrair(a, b):\n",
        "    \"\"\"Retorna a diferença entre dois números.\"\"\"\n",
        "    return a - b\n",
        "\n",
        "def multiplicar(a, b):\n",
        "    \"\"\"Retorna o produto de dois números.\"\"\"\n",
        "    return a * b\n",
        "\n",
        "def dividir(a, b):\n",
        "    \"\"\"Retorna o quociente da divisão de dois números. Trata divisão por zero.\"\"\"\n",
        "    if b == 0:\n",
        "        return \"Erro: Não é possível dividir por zero!\"\n",
        "    return a / b\n",
        "\n",
        "# 2. Mapeamento das operações para as funções correspondentes\n",
        "# Isso reduz o uso de 'if/elif' para selecionar a operação.\n",
        "operacoes = {\n",
        "    '+': somar,\n",
        "    '-': subtrair,\n",
        "    '*': multiplicar,\n",
        "    '/': dividir\n",
        "}\n",
        "\n",
        "# 3. Função principal da calculadora\n",
        "def calculadora():\n",
        "    print(\"\\n--- Calculadora Python Simples ---\")\n",
        "    print(\"Operações disponíveis:\")\n",
        "    print(\"  + para Adição\")\n",
        "    print(\"  - para Subtração\")\n",
        "    print(\"  * para Multiplicação\")\n",
        "    print(\"  / para Divisão\")\n",
        "\n",
        "    while True:\n",
        "        operador = input(\"\\nEscolha uma operação (+, -, *, /) ou 'sair' para encerrar: \").lower()\n",
        "\n",
        "        if operador == 'sair':\n",
        "            print(\"Calculadora encerrada. Até a próxima!\")\n",
        "            break\n",
        "\n",
        "        if operador not in operacoes:\n",
        "            print(\"Operador inválido. Por favor, escolha +, -, * ou /.\")\n",
        "            continue\n",
        "\n",
        "        try:\n",
        "            num1 = float(input(\"Digite o primeiro número: \"))\n",
        "            num2 = float(input(\"Digite o segundo número: \"))\n",
        "        except ValueError:\n",
        "            print(\"Entrada inválida. Certifique-se de digitar apenas números.\")\n",
        "            continue\n",
        "\n",
        "        # Executa a operação usando o dicionário\n",
        "        resultado = operacoes[operador](num1, num2)\n",
        "\n",
        "        # Exibe o resultado\n",
        "        print(f\"{num1} {operador} {num2} = {resultado}\")\n",
        "\n",
        "# 4. Inicia a calculadora\n",
        "if __name__ == \"__main__\":\n",
        "    calculadora()\n",
        "\n",
