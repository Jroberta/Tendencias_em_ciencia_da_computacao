"""
Interface principal da calculadora
"""

from calculadora import Calculadora

def exibir_menu():
    """Exibe o menu de operações"""
    print("\n" + "="*40)
    print("      CALCULADORA MODULAR")
    print("="*40)
    print("Operações disponíveis:")
    print("  +    : Soma")
    print("  -    : Subtração")
    print("  *    : Multiplicação")
    print("  /    : Divisão")
    print("  **   : Potência")
    print("  sqrt : Raiz Quadrada")
    print("  h    : Ver histórico")
    print("  l    : Limpar histórico")
    print("  s    : Sair")
    print("="*40)


def main():
    """Função principal do programa"""
    calculadora = Calculadora()
    
    while True:
        exibir_menu()
        operacao = input("\nEscolha uma operação: ").strip()
        
        if operacao.lower() == 's':
            print("\nAté logo!")
            break
        
        elif operacao.lower() == 'h':
            if calculadora.historico:
                print("\nHistórico de operações:")
                for i, operacao_realizada in enumerate(calculadora.historico, 1):
                    print(f"  {i}. {operacao_realizada}")
            else:
                print("\nHistórico vazio!")
        
        elif operacao.lower() == 'l':
            calculadora.limpar_historico()
            print("\nHistórico limpo!")
        
        elif operacao.lower() == 'sqrt':
            try:
                num = input("Digite o número: ")
                resultado = calculadora.calcular(num, 'sqrt')
                print(f"\nResultado: {resultado}")
            except ValueError as e:
                print(f"\n{e}")
        
        elif operacao in ['+', '-', '*', '/', '**']:
            try:
                num1 = input("Digite o primeiro número: ")
                num2 = input("Digite o segundo número: ")
                resultado = calculadora.calcular(num1, operacao, num2)
                print(f"\nResultado: {resultado}")
            except ValueError as e:
                print(f"\n{e}")
        
        else:
            print("\nOperação inválida! Tente novamente.")


if __name__ == "__main__":
    main()

