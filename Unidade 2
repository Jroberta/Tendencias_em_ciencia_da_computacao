def exibir_historico(calculadora: Calculadora) -> None:
    """Exibe o histórico de operações."""
    if not calculadora.historico:
        print("\nHistórico vazio!")
        return

    print("\nHistórico de operações:")

    for indice, operacao in enumerate(calculadora.historico, start=1):
        print(f"  {indice}. {operacao}")


def executar_calculo(
    calculadora: Calculadora,
    operacao: str,
) -> None:
    """Solicita os números e executa a operação."""
    try:
        primeiro_numero = input("Digite o primeiro número: ")

        if operacao == "sqrt":
            resultado = calculadora.calcular(primeiro_numero, operacao)
        else:
            segundo_numero = input("Digite o segundo número: ")
            resultado = calculadora.calcular(
                primeiro_numero,
                operacao,
                segundo_numero,
            )

        print(f"\nResultado: {resultado:g}")

    except ValueError as erro:
        print(f"\nErro: {erro}")


def processar_comando(
    calculadora: Calculadora,
    comando: str,
) -> bool:
    """
    Processa um comando.

    Retorna False quando o programa deve ser encerrado.
    """
    if comando == "s":
        print("\nAté logo!")
        return False

    if comando == "h":
        exibir_historico(calculadora)
        return True

    if comando == "l":
        calculadora.limpar_historico()
        print("\nHistórico limpo!")
        return True

    if comando in calculadora.OPERACOES:
        executar_calculo(calculadora, comando)
        return True

    print("\nOperação inválida! Tente novamente.")
    return True


def main() -> None:
    """Executa a aplicação."""
    calculadora = Calculadora()

    while True:
        exibir_menu()
        comando = input("\nEscolha uma operação: ").strip().lower()

        if not processar_comando(calculadora, comando):
            break


if __name__ == "__main__":
    main()
